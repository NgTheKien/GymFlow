# Sao chép thành .env rồi chỉnh giá trị. KHÔNG commit file .env
# Giá trị dưới chỉ dùng cho máy local. Đổi toàn bộ mật khẩu trước khi triển khai công khai.
MYSQL_DATABASE=gymflow
MYSQL_USER=gymflow
MYSQL_PASSWORD=gymflow_dev_password
MYSQL_ROOT_PASSWORD=root_dev_password
MYSQL_PORT=3307
BACKEND_PORT=8080
FRONTEND_PORT=8081
# Cổng web trên VPS khi chạy kèm compose.prod.yaml
PROD_FRONTEND_PORT=3000
# Chỉ cần khi gọi API từ một domain/cổng khác với giao diện (giao diện qua nginx dùng chung origin nên không cần)
CORS_ALLOWED_ORIGINS=http://localhost:5173,http://localhost:8081

# Tối thiểu 32 ký tự. Sinh ngẫu nhiên: openssl rand -base64 48
JWT_SECRET=change-me-please-use-at-least-32-characters-long
JWT_EXPIRATION_MINUTES=720
# Cho phép hội viên tự đăng ký tài khoản trên website
REGISTRATION_ENABLED=true
# Giới hạn đăng nhập 10 lần/phút, đăng ký và quên mật khẩu 5 lần/10 phút cho mỗi IP
RATE_LIMIT_ENABLED=true

# ---- Chế độ demo: TẮT cả 3 dòng dưới khi triển khai thật ----
# Tự sinh dữ liệu mẫu khi CSDL trống
SEED_DEMO_DATA=true
# Hiện nút đăng nhập nhanh bằng tài khoản demo
DEMO_QUICK_LOGIN=true
# Trả mã đặt lại mật khẩu trong response (chưa tích hợp gửi email)
RESET_EXPOSE_TOKEN=true
